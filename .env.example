# =============================================================
# Variáveis de ambiente do FamFin
# Copie este arquivo para ".env" e preencha com seus valores
# =============================================================

# URL de conexão com o banco PostgreSQL (Supabase)
# Pegue no painel do Supabase: Project Settings > Database > Connection string > URI
# Formato: postgresql://postgres.[ID]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.XXX:YYY@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# (Opcional) Chave de serviço do Supabase para operações administrativas
# Pegue no painel: Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=""

# (Opcional) Para envio de e-mails (Resend)
RESEND_API_KEY=""

# (Opcional) Para integração com Mercado Pago (futuro)
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_PUBLIC_KEY=""
